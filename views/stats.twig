<!doctype html>
<html>
<head>
    <meta charset="utf-8">

    <title>Transport API - Statistics</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.6/css/bootstrap.min.css" />
    <link rel="stylesheet" href="media/css/layout.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.2.4/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/hammer.js/2.0.8/hammer.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-zoom/0.7.7/chartjs-plugin-zoom.min.js"></script>

    <script>
    $(function () {

        function formatNumber(value) {
            return value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, "'");
        }

        // show loading message
        var loadingIntervalCount = 3;
        var loadingInterval = setInterval(function () {
            loadingIntervalCount = (loadingIntervalCount + 1) % 4;
            var loading = '';
            for (var j = 0; j < 3; j++) {
                if (j < loadingIntervalCount) {
                    loading += '.';
                } else {
                    loading += '&nbsp;';
                }
            }
            $('#statsChartLoadingCount').html(loading);
        }, 300);

        // load data
        $.getJSON('?format=json', function(response) {

            // parse data
            var calls = $.map(response.data, function (value) {
                return {x: value.date, y: value.calls};
            });

            // remove last element (today)
            calls = calls.reverse().splice(1).reverse();

            // render graph
            var canvas = $("#statsChart");
            var statsChart = new Chart(canvas, {
                type: 'line',
                data: {
                    datasets: [{
                        label: 'Calls',
                        data: calls,
                        borderWidth: 1,
                        borderColor: '#008000',
                        backgroundColor: '#ddeddc',
                        pointBackgroundColor: '#008000',
                        pointRadius: 0,
                        lineTension: 0
                    }]
                },
                options: {
                    legend: {
                        display: false
                    },
                    tooltips: {
                        mode: 'index',
                        intersect: false,
                        callbacks: {
                            label: function (item) {
                                return formatNumber(item.yLabel) + ' calls';
                            }
                        }
                    },
                    hover: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        zoom: {
                            zoom: {
                                enabled: true,
                                drag: true,
                                mode: 'x',
                                onZoomComplete: function () {
                                    $('#statsChartReset').show();
                                }
                            }
                        }
                    },
                    scales: {
                        xAxes: [{
                            type: 'time'
                        }],
                        yAxes: [{
                            ticks: {
                                callback: formatNumber
                            }
                        }]
                    }
                }
            });

            $('#statsChartLoading').hide();

            function resetZoom() {
                statsChart.resetZoom();
                $('#statsChartReset').hide();
            }

            canvas.on('dblclick', resetZoom);
            $('#statsChartReset').on('click', function (e) {
                e.preventDefault();
                resetZoom();
            });
        });
    });
    </script>
</head>
<body lang="en">

    <div class="container">

        <header>
            <h1><a href="./">Transport</a></h1>
            <p>Swiss public transport API</p>
        </header>

        <article>
            <h2>Statistics</h2>
            <div class="row">
                <div class="col-sm-4">
                    <p>
                        Total calls<br/>
                        <span class="lead">{{ total | number_format(0, ".", "'") }}</span>
                    </p>
                </div>
                <div class="col-sm-4">
                    <p>
                        Average calls per day<br/>
                        <span class="lead">{{ avg | number_format(0, ".", "'") }}</span>
                    </p>
                </div>
                <div class="col-sm-4">
                    <p>
                        Max calls for one day<br/>
                        <span class="lead">{{ max | number_format(0, ".", "'") }}</span>
                    </p>
                </div>
            </div>

            <br/>

            <div style="position: relative;">
                <canvas id="statsChart" width="800" height="200" style="width: 100%;"></canvas>
                <div id="statsChartLoading" style="position: absolute; top: 50%; width: 100%;" class="text-muted text-center lead">
                    Loading chart <span id="statsChartLoadingCount">...</span>
                </div>
                <a href="#" id="statsChartReset" style="display: none; position: absolute; top: 5px; right: 15px;"><small>Reset zoom</small></a>
            </div>

            <div class="row">
                <div class="col-sm-4">
                    <h2 title="Top 5 since 10. Aug. 2012">Resources</h2>
                    <ul class="list-unstyled">
                        {% for resource in resources %}
                        <li><span class="value">{{ resource.path }}</span> <span class="text-disabled">{{ resource.calls | number_format(0, ".", "'") }}</span></li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="col-sm-4">
                    <h2 title="Top 5 since 10. Aug. 2012">Stations</h2>
                    <ul class="list-unstyled">
                        {% for station in stations %}
                        <li title="{{ station.y }}, {{ station.x }}"><span class="value">{{ station.name }}</span> <span class="text-disabled">{{ station.calls | number_format(0, ".", "'") }}</span></li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="col-sm-4">
                    <h2 title="Top 5 since 22. November 2015">Errors</h2>
                    <ul class="list-unstyled">
                        {% for error in errors %}
                            <li title="{{ error.exception }}{% if error.description %} – {{ error.description }}{% endif %}"><span class="value">{{ error.name }}</span>{% if error.status %} <span class="label label-default">{{ error.status }}</span>{% endif %} <span class="text-disabled">{{ error.calls | number_format(0, ".", "'") }}</span></li>
                        {% endfor %}
                    </ul>
                    <p><small><a href="#error-details">All errors in detail</a></small></p>
                </div>
            </div>

            <h2 id="error-details">Errors in detail</h2>

            <form class="form-inline stats-window" onsubmit="return false;">
                <label for="statsWindowSelect" class="sr-only">Time window</label>
                <select id="statsWindowSelect" class="form-control input-sm">
                    {% for key, label in windows %}
                    <option value="{{ key }}"{% if key == window.window %} selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
                <input id="statsWindowSlider" type="range" min="0" max="{{ windows | length - 1 }}" step="1" aria-label="Time window">
                <span id="statsWindowLoading" class="text-muted" style="display: none;"><small>Loading …</small></span>
            </form>

            <div class="row stats-summary">
                <div class="col-xs-6 col-sm-3"><p>Calls<br/><span class="lead" id="statsSumCalls"></span></p></div>
                <div class="col-xs-6 col-sm-3"><p>Errors<br/><span class="lead" id="statsSumErrors"></span></p></div>
                <div class="col-xs-6 col-sm-3"><p>Error rate<br/><span class="lead" id="statsSumRate"></span></p></div>
                <div class="col-xs-6 col-sm-3"><p title="Requests rejected with HTTP 429, by this API or by timetable.search.ch">Rate limited (429)<br/><span class="lead" id="statsSumRateLimited"></span></p></div>
            </div>

            <p class="text-muted" id="statsWindowNote"></p>

            <div class="table-responsive">
                <table class="table table-condensed stats-table">
                    <thead>
                        <tr>
                            <th>Error</th>
                            <th>Status</th>
                            <th>Meaning</th>
                            <th class="text-right">Count</th>
                            <th class="text-right">Share</th>
                        </tr>
                    </thead>
                    <tbody id="statsExceptions"></tbody>
                </table>
            </div>

            <h3 id="statsRowsTitle"></h3>
            <div class="table-responsive">
                <table class="table table-condensed stats-table">
                    <thead>
                        <tr>
                            <th id="statsRowsHead">Date</th>
                            <th class="text-right">Calls</th>
                            <th class="text-right">Errors</th>
                            <th class="text-right">Error rate</th>
                            <th class="text-right" title="Requests rejected with HTTP 429, by this API or by timetable.search.ch">Rate limited (429)</th>
                        </tr>
                    </thead>
                    <tbody id="statsRows"></tbody>
                </table>
            </div>

            <script>
            (function () {
                var windows = {{ windows | keys | json_encode | raw }};
                var initial = {{ window | json_encode | raw }};

                function number(value) {
                    if (value === null) {
                        return '–';
                    }
                    return value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, "'");
                }

                function percent(part, whole, digits) {
                    if (!whole) {
                        return '–';
                    }
                    var value = 100 * part / whole;
                    if (value > 0 && value < Math.pow(10, -digits)) {
                        return '&lt;&nbsp;' + Math.pow(10, -digits).toFixed(digits) + '&nbsp;%';
                    }
                    return value.toFixed(digits) + '&nbsp;%';
                }

                function text(value) {
                    return $('<div>').text(value).html();
                }

                function render(data) {
                    // the all-time view has totals by class only; its rows are the last 14 days
                    $('.stats-summary').toggle(data.window !== 'all');
                    var calls = data.calls + (data.ratelimited || 0);
                    $('#statsSumCalls').text(number(data.calls));
                    $('#statsSumErrors').text(number(data.errors));
                    $('#statsSumRate').html(percent(data.errors, data.calls, 3));
                    $('#statsSumRateLimited').html(data.ratelimited === null ? '–' : number(data.ratelimited) + ' <small class="text-muted">' + percent(data.ratelimited, calls, 1) + '</small>');

                    var note;
                    if (data.window === 'all') {
                        note = 'Every error the API has recorded since 22. November 2015, ' + number(data.classTotal) + ' in total. Calls and errors below are for the last 14 days.';
                    } else if (data.since === null) {
                        note = 'No hourly data for this window yet: the split by error class and the rate-limited requests are recorded hourly from 23. September 2026 on.';
                    } else {
                        note = 'Split by error class and rate-limited requests recorded hourly since ' + moment(data.since).format('DD.MM.YYYY HH:mm') + '.';
                    }
                    $('#statsWindowNote').text(note + ' Rate-limited requests (HTTP 429) are neither calls nor errors.');

                    var exceptions = $.map(data.exceptions, function (e) {
                        return '<tr>' +
                            '<td class="stats-exception" title="' + text(e.exception) + '">' + text(e.name) + (e.namespace ? '<br/><small class="text-muted">' + text(e.namespace) + '</small>' : '') + '</td>' +
                            '<td>' + text(e.status) + '</td>' +
                            '<td>' + text(e.description) + '</td>' +
                            '<td class="text-right stats-number">' + number(e.calls) + '</td>' +
                            '<td class="text-right stats-number">' + percent(e.calls, data.classTotal, 1) + '</td>' +
                            '</tr>';
                    });
                    $('#statsExceptions').html(exceptions.length ? exceptions.join('') : '<tr><td colspan="5" class="text-muted">No errors recorded in this window.</td></tr>');

                    var hourly = data.granularity === 'hour';
                    $('#statsRowsTitle').text(hourly ? 'By hour' : (data.window === 'all' ? 'Last 14 days' : 'By day'));
                    $('#statsRowsHead').text(hourly ? 'Hour' : 'Date');
                    var rows = $.map(data.rows, function (row, index) {
                        var label = hourly
                            ? moment(row.start).format('DD.MM.YYYY HH:mm') + '–' + moment(row.start).add(1, 'hour').format('HH:mm')
                            : moment(row.start).format('DD.MM.YYYY');
                        return '<tr>' +
                            '<td class="stats-number">' + label + (index === 0 ? ' <small class="text-muted">(so far)</small>' : '') + '</td>' +
                            '<td class="text-right stats-number">' + number(row.calls) + '</td>' +
                            '<td class="text-right stats-number">' + number(row.errors) + '</td>' +
                            '<td class="text-right stats-number">' + percent(row.errors, row.calls, 3) + '</td>' +
                            '<td class="text-right stats-number">' + number(row.ratelimited) + '</td>' +
                            '</tr>';
                    });
                    $('#statsRows').html(rows.join(''));
                }

                var select = $('#statsWindowSelect');
                var slider = $('#statsWindowSlider');
                var request = null;
                var timer = null;

                function load(key) {
                    if (request) {
                        request.abort();
                    }
                    $('#statsWindowLoading').show();
                    request = $.getJSON('?format=window&window=' + encodeURIComponent(key), function (data) {
                        render(data);
                    }).always(function () {
                        $('#statsWindowLoading').hide();
                    });
                }

                select.on('change', function () {
                    slider.val(windows.indexOf(select.val()));
                    load(select.val());
                });

                // the slider follows the select while dragging and loads once it rests
                slider.on('input change', function () {
                    select.val(windows[slider.val()]);
                    clearTimeout(timer);
                    timer = setTimeout(function () {
                        load(select.val());
                    }, 250);
                });

                slider.val(windows.indexOf(initial.window));
                render(initial);
            })();
            </script>
        </article>

        <footer class="footer">
            <hr>
            <p>Powered by <a href="http://opendata.ch/">Opendata.ch.</a> <a href="https://donate.raisenow.io/bxqvn" target="_blank">Donate now to support open data in Switzerland</a>.</p>
        </footer>

    </div>

</body>
</html>
