# Keep the build context to what the image actually runs.
# Without this, `COPY . /var/www/html/` carries 11 MB of git history and the
# test fixtures into every layer — and into every pull, on every server.
.git
.github
.gitlab-ci.yml
test
vendor
var/cache/*
var/logs/*
config.php
docker-compose.yml
# The Python service is its own image, built from service/ with its own
# Dockerfile. It has no business inside the PHP one.
service
*.md
