# The image of gitlab.com/opendata.ch/Transport to run: a commit's short SHA,
# as the CI tags it (CI_COMMIT_SHORT_SHA), or latest.
SERVICE_IMAGE_TAG=latest
# The timetable database; internal to the compose network.
DB_PASSWORD=change-me
# GTFS-RT on api-manager.opentransportdata.swiss (one key per environment).
OTD_API_KEY=
# Train Formation Service on the same API manager; empty: no formations.
OTD_FORMATION_KEY=
